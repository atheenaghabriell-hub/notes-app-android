<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6"
    android:fillViewport="true"
    tools:context=".ThemeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back"
                app:tint="#111111" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/title_theme"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- PREFERENCES Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_preferences"
            android:textColor="#666666"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/btnLightMode"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#FFFFFF"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:paddingHorizontal="16dp"
                android:text="@string/btn_light_mode"
                android:textAllCaps="false"
                android:textColor="#4F46E5"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                app:strokeColor="#4F46E5"
                app:strokeWidth="1.5dp"
                app:drawableTint="#4F46E5" />

            <Button
                android:id="@+id/btnDarkMode"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#374151"
                android:drawableStart="@android:drawable/ic_menu_manage"
                android:paddingHorizontal="16dp"
                android:text="@string/btn_dark_mode"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                app:drawableTint="#FFFFFF" />
        </LinearLayout>

        <!-- CUSTOM THEMES Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_custom_themes"
            android:textColor="#666666"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_gradient_theme"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/subtitle_choose_gradient"
                    android:textColor="#666666"
                    android:textSize="14sp" />

                <!-- Horizontal Scroll for Gradients -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Gradient Item: Sunset -->
                        <LinearLayout
                            android:id="@+id/cardSunset"
                            android:layout_width="84dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/rounded_edittext"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">
                            <View
                                android:layout_width="72dp"
                                android:layout_height="56dp"
                                android:background="@drawable/gradient_sunset" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/theme_sunset"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gradient Item: Forest -->
                        <LinearLayout
                            android:id="@+id/cardForest"
                            android:layout_width="84dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/rounded_edittext"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">
                            <View
                                android:layout_width="72dp"
                                android:layout_height="56dp"
                                android:background="@drawable/gradient_forest" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/theme_forest"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gradient Item: Ocean -->
                        <LinearLayout
                            android:id="@+id/cardOcean"
                            android:layout_width="84dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/rounded_edittext"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">
                            <View
                                android:layout_width="72dp"
                                android:layout_height="56dp"
                                android:background="@drawable/gradient_ocean" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/theme_ocean"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gradient Item: Berry -->
                        <LinearLayout
                            android:id="@+id/cardBerry"
                            android:layout_width="84dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/rounded_edittext"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">
                            <View
                                android:layout_width="72dp"
                                android:layout_height="56dp"
                                android:background="@drawable/gradient_berry" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/theme_berry"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gradient Item: Royal -->
                        <LinearLayout
                            android:id="@+id/cardRoyal"
                            android:layout_width="84dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/rounded_edittext"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">
                            <View
                                android:layout_width="72dp"
                                android:layout_height="56dp"
                                android:background="@drawable/gradient_royal" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/theme_royal"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gradient Item: Emerald -->
                        <LinearLayout
                            android:id="@+id/cardEmerald"
                            android:layout_width="84dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/rounded_edittext"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">
                            <View
                                android:layout_width="72dp"
                                android:layout_height="56dp"
                                android:background="@drawable/gradient_emerald" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/theme_emerald"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gradient Item: Lavender -->
                        <LinearLayout
                            android:id="@+id/cardLavender"
                            android:layout_width="84dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/rounded_edittext"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">
                            <View
                                android:layout_width="72dp"
                                android:layout_height="56dp"
                                android:background="@drawable/gradient_lavender" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/theme_lavender"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gradient Item: Cosmic -->
                        <LinearLayout
                            android:id="@+id/cardCosmic"
                            android:layout_width="84dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/rounded_edittext"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">
                            <View
                                android:layout_width="72dp"
                                android:layout_height="56dp"
                                android:background="@drawable/gradient_cosmic" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/theme_cosmic"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gradient Item: Amber -->
                        <LinearLayout
                            android:id="@+id/cardAmber"
                            android:layout_width="84dp"
                            android:layout_height="100dp"
                            android:background="@drawable/rounded_edittext"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">
                            <View
                                android:layout_width="72dp"
                                android:layout_height="56dp"
                                android:background="@drawable/gradient_amber" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/theme_amber"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Custom Gradient Slider Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_custom_gradient_slider"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_adjust_blend"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_color_1"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/rounded_edittext"
                android:backgroundTint="#FF9800" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_color_2"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/rounded_edittext"
                android:backgroundTint="#FFEB3B" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/gradientSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:progress="50"
            android:thumbTint="#FF9800"
            android:progressTint="#FF9800" />

        <!-- Theme Preview Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_theme_preview"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/gradient_sunset"
                    android:gravity="center"
                    android:text="@string/preview_notes"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/preview_full_name"
                    android:textColor="#666666"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/rounded_edittext"
                    android:padding="10dp"
                    android:text="@string/preview_your_name"
                    android:textColor="#111111"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/preview_email"
                    android:textColor="#666666"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/rounded_edittext"
                    android:padding="10dp"
                    android:text="@string/preview_email_example"
                    android:textColor="#111111"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
